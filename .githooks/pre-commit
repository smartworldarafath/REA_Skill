#!/usr/bin/env bash
# Git Pre-Commit Hook: Zero-Secret Leak Gate
# Prevents committing API keys, tokens, credentials, and private keys.

PATTERNS=(
    'AIzaSy[0-9A-Za-z_-]{33}'
    '(^|[^a-zA-Z0-9_-])sk-[a-zA-Z0-9_-]{20,}'
    'ghp_[a-zA-Z0-9]{36}'
    'gho_[a-zA-Z0-9]{36}'
    'github_pat_[a-zA-Z0-9_]{60,}'
    'AKIA[0-9A-Z]{16}'
    'xoxb-[0-9]{11,13}-[0-9]{11,13}-[a-zA-Z0-9]{24}'
    '[0-9]{8,10}:[A-Za-z0-9_-]{35}'
    'BEGIN (RSA|EC|OPENSSH|DSA|PGP|PRIVATE) KEY'
    'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9\.[a-zA-Z0-9_-]{30,}\.[a-zA-Z0-9_-]{30,}'
)

STAGED_DIFF=$(git diff --cached --unified=0 | grep -E '^\+[^\+]')

for PATTERN in "${PATTERNS[@]}"; do
    MATCHES=$(echo "$STAGED_DIFF" | grep -E -e "$PATTERN" | grep -viE -e '(placeholder|your_|example|dummy|\$\{|https?://|jwt_tool|eyJzdWIiOiIxMjM0NTY3ODkw)')
    if [ -n "$MATCHES" ]; then
        echo "================================================================"
        echo "[SECURITY GATE REJECTED] Secret pattern detected in staged diff!"
        echo "Pattern: $PATTERN"
        echo "Matches:"
        echo "$MATCHES" | head -n 5
        echo "================================================================"
        echo "Aborting commit. Please sanitize secrets before committing."
        exit 1
    fi
done

exit 0
